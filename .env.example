# Copy to .env and fill in. Only GOOGLE_PLACES_API_KEY is required.
# No LLM key: drafting is done by Claude Code, not the Anthropic API.
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=

# Only needed for `send` / `followup` / `sync`. This is a Gmail App Password,
# not your account password: turn on 2-step verification, then
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
